{
  "database": {
    "path": "database.db",
    "auto_create": true
  },
  "lm_studio": {
    "base_url": "http://localhost:1234/v1",
    "timeout": 30,
    "temperature": 0.1,
    "max_tokens": 500
  },
  "security": {
    "auto_execute": false,
    "allow_drop": false,
    "allow_alter": true
  },
  "logging": {
    "enabled": true,
    "level": "INFO",
    "file": "nexus_spider.log"
  }
}
